        {"name": "active_c", "description": "瞬时C相有功功率", "type": "bcd", "length": 4, "byte_order": "little", "decimals": 4, "sign_bit": {"byte": 0, "mask": "80"}, "unit": "kW"},
        {"name": "reactive_total", "description": "瞬时总无功功率", "type": "bcd", "length": 4, "byte_order": "little", "decimals": 4, "unit": "kvar"},
        {"name": "reactive_a", "description": "瞬时A相无功功率", "type": "bcd", "length": 4, "byte_order": "little", "decimals": 4, "unit": "kvar"},
        {"name": "reactive_b", "description": "瞬时B相无功功率", "type": "bcd", "length": 4, "byte_order": "little", "decimals": 4, "unit": "kvar"},
